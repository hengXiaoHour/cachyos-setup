{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": {
      "*": "allow"
    },
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask"
  },
  "plugin": [
    "~/.config/opencode/plugins/memory-mcp",
    "~/.config/opencode/plugins/subagent-orchestrator",
    "~/.config/opencode/plugins/github-sync",
    "~/.config/opencode/plugins/playwright-mcp"
  ]
}
